{
  "manifest_version": 3,
  "name": "Adaptive Reading Assistant",
  "version": "1.0.0",
  "description": "Privacy-preserving adaptive reading assistance with tiered dyslexia-friendly typography.",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/contentScript.js"],
      "run_at": "document_idle",
      "type": "module"
    }
  ],
  "action": {
    "default_title": "Adaptive Reading Assistant"
  }
}
